
{
  "entities": {
    "MachiningRecord": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MachiningRecord",
      "type": "object",
      "description": "Represents a single machining record with detailed information about the process.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "material": { "type": "string" },
        "tool": { "type": "string" },
        "speed": { "type": "number" },
        "feedRate": { "type": "number" },
        "dateTime": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      },
      "required": ["id", "userId", "material", "tool", "speed", "feedRate", "dateTime"]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" }
      },
      "required": ["id", "email"]
    },
    "FilaItem": {
      "title": "FilaItem",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requisicao": { "type": "string" },
        "nomeDaPeca": { "type": "string" },
        "quantidade": { "type": "number" },
        "setup": { "type": "number" },
        "torno": { "type": "number" },
        "centro": { "type": "number" },
        "prog": { "type": "number" },
        "site": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "Stores user profile information."
        }
      },
      {
        "path": "/productionRecords/{recordId}",
        "definition": {
          "description": "Stores machining production records."
        }
      },
      {
        "path": "/lossRecords/{recordId}",
        "definition": {
          "description": "Stores machining loss records."
        }
      },
      {
        "path": "/programacaoState/{stateId}",
        "definition": {
          "description": "Stores the current state of production queue and timeline."
        }
      }
    ],
    "reasoning": "Using Firestore for all state management ensures consistency and stability within the prototype environment."
  }
}
