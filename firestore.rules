
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }
    
    match /productionRecords/{recordId} {
      allow read, write: if isSignedIn();
    }

    match /lossRecords/{recordId} {
      allow read, write: if isSignedIn();
    }

    match /programacaoState/{stateId} {
      allow read, write: if isSignedIn();
    }

    // Compatibilidade com coleções antigas se existirem
    match /machineSchedules/{scheduleId} {
      allow read, write: if isSignedIn();
    }
    match /planoSemanal/{planoId} {
      allow read, write: if isSignedIn();
    }
  }
}
